#!/usr/bin/env sh

# ==============================================================================
# YABAI CONFIGURATION FILE
# Location: ~/.config/yabai/yabairc
# ==============================================================================

# 1. Layout Mode
# Set the default window layout to Binary Space Partitioning (tiling)
yabai -m config layout bsp

# 2. Default Split Ratio
# Sets new split windows to take 30% for the first window and 70% for the second
yabai -m config split_ratio 0.30

# 3. Outer Screen Padding (20px gap on all outer screen edges)
yabai -m config top_padding    20
yabai -m config bottom_padding 20
yabai -m config left_padding   20
yabai -m config right_padding  20

# 4. Inner Window Gaps (20px gap between adjacent windows)
yabai -m config window_gap     20

# ==============================================================================
# APPLICATION RULES
# ==============================================================================

# Ignore Godot/Finder/Whatever so they floats normally instead of tiling
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Godot$" manage=off

#yabai -m rule --add app="^Finder$" manage=off
#yabai -m rule --add app="^Finder$" manage=off

# ==============================================================================
# RECOMMENDED DEFAULTS
# ==============================================================================

# New windows spawn on the right/bottom side of the focused split
yabai -m config window_placement second_child

# Mouse behavior
yabai -m config focus_follows_mouse off
yabai -m config mouse_follows_focus off

echo "Yabai configuration loaded successfully!"
