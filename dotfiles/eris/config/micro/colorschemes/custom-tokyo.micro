# Custom Tokyo Theme for Micro
color-link default "#a9b1d6,#1a1b26"
color-link comment "#787c99"

# Syntax Highlighting
color-link identifier "#7dcfff"
color-link constant "#e0af68"
color-link constant.string "#41a6b5"
color-link constant.number "#e0af68"
color-link statement "#bb9af7"
color-link symbol "#7dcfff"
color-link preproc "#7dcfff"
color-link type "#7aa2f7"
color-link special "#f7768e"
color-link error "bold #f7768e"
color-link todo "bold #e0af68"

# Editor UI Elements
color-link statusline "#a9b1d6,#363b54"
color-link tabbar "#a9b1d6,#1a1b26"
color-link indent-char "#363b54"
color-link line-number "#363b54,#1a1b26"
color-link current-line-number "#7aa2f7,#1a1b26"
color-link cursor-line "#283454"
color-link selection "#acb0d0,#283454"
color-link divider "#363b54"
