# Tokyo Night theme for bpytop

# Main background
theme[main_bg]="#1a1b26"

# Main text color
theme[main_fg]="#a9b1d6"

# Title color for boxes
theme[title]="#7aa2f7"

# Highlight color for key shortcuts
theme[hi_fg]="#7dcfff"

# Background color of selected item in processes box
theme[selected_bg]="#363b54"

# Foreground color of selected item in processes box
theme[selected_fg]="#7aa2f7"

# Color of inactive/disabled text
theme[inactive_fg]="#787c99"

# Color of text appearing on top of graphs
theme[graph_text]="#a9b1d6"

# Misc text color for process mini-graph
theme[proc_misc]="#bb9af7"

# Cpu box outline color
theme[cpu_box]="#7aa2f7"

# Memory box outline color
theme[mem_box]="#bb9af7"

# Net box outline color
theme[net_box]="#41a6b5"

# Processes box outline color
theme[proc_box]="#7dcfff"

# Box divider line color
theme[div_line]="#363b54"

# Temperature graph colors
theme[temp_start]="#41a6b5"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

# CPU graph colors
theme[cpu_start]="#41a6b5"
theme[cpu_mid]="#e0af68"
theme[cpu_end]="#f7768e"

# Mem/Disk free meter
theme[free_start]="#41a6b5"
theme[free_mid]="#7dcfff"
theme[free_end]="#7aa2f7"

# Mem/Disk cached meter
theme[cached_start]="#7dcfff"
theme[cached_mid]="#7aa2f7"
theme[cached_end]="#bb9af7"

# Mem/Disk available meter
theme[available_start]="#7aa2f7"
theme[available_mid]="#bb9af7"
theme[available_end]="#e0af68"

# Mem/Disk used meter
theme[used_start]="#e0af68"
theme[used_mid]="#f7768e"
theme[used_end]="#f7768e"

# Download graph colors
theme[download_start]="#41a6b5"
theme[download_mid]="#7dcfff"
theme[download_end]="#7aa2f7"

# Upload graph colors
theme[upload_start]="#bb9af7"
theme[upload_mid]="#e0af68"
theme[upload_end]="#f7768e"

# Process box color gradient for Process tree
theme[process_start]="#41a6b5"
theme[process_mid]="#7dcfff"
theme[process_end]="#7aa2f7"