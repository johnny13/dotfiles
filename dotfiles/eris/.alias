
alias la='ls -la'
alias lx='exa -labhm --no-permissions --git --modified --color-scale --icons --group-directories-first'
alias lsown='exa -lbhma --icons --color-scale --group-directories-first --sort=modified'
alias lsmodtree='exa --sort=modified -T -L 2 --group-directories-first'
alias lsmod='exa --sort=modified -l'
alias lb='/bin/ls --color=auto -alF'
alias ll='lsd -1lhF --size short --group-directories-first --blocks user,git,size,date,name --header'
alias ldis='exa -lh --no-user --no-time --no-permissions --sort=type'

alias reload='source ~/.config/zsh/.zshrc'

alias lcdstats='nohup ./STARTUP.sh > /dev/null 2>&1 &'

alias dsclean='find . -name ".DS_Store" -print -delete'

# Make switching versions easy
function phpv() {
    brew unlink php
    brew link --overwrite --force "php@$1"
    php -v
}

alias imgurUpload='/Users/eris/Dotfiles/scripts/imgur/imgurbash2'

# Editing Files
alias e-nginx-default="micro /usr/local/etc/nginx/sites-enabled/default.conf"
alias e-zsh="micro ~/.config/zsh/.zshrc"
alias e-alias="micro ~/.alias"

alias myscripts="cd ~/Dotfiles/scripts/macos"

alias fbat="fzf --preview 'bat --style=numbers --color=always {}'"

alias aseprite="/Users/eris/Pictures/_Sprites/Aseprite-v1.3.16.1-Source/build/bin/aseprite"

# Network Tools
alias ipaddy='ipconfig getifaddr en1'
alias ipaddy_public='curl icanhazip.com'

# Laravel Sail
alias sail='./vendor/bin/sail'
alias dsail='./vendor/bin/sail'
alias sphp="./vendor/bin/sail php"
alias sartisan="./vendor/bin/sail artisan"
alias scomposer="./vendor/bin/sail composer"
alias spnpm="./vendor/bin/sail pnpm"
alias sqmigrate="./vendor/bin/sail artisan migrate --database=forge --path=database/migrations/forge"

newSQL() {
    ./vendor/bin/sail artisan make:migration "$1" --table=sources --path=database/migrations/forge
}

alias webp2png="/Users/eris/Dotfiles/scripts/macos/webp2png.sh"
alias png2webp="/Users/eris/Dotfiles/scripts/macos/png2webp.sh"

